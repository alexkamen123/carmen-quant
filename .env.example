# 复制此文件为 .env，填入你的密钥（.env 已在 .gitignore 中，不会被提交）

# ── 必填 ───────────────────────────────────────────────────────────
# DeepSeek API Key（Bull/Bear 辩论主力模型，价格极低）
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选：Claude（有则提升基本面分析和最终裁决质量，否则全程 DeepSeek）──
# 方式一：Anthropic API Key（付费）
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
#
# 方式二：Claude Pro 订阅的 OAuth Token（免额外费用）
# 获取：在装有 Claude Code CLI 的终端执行 `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# ── 可选：飞书推送（不填则只打印到终端）─────────────────────────────
# 飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 开启「签名校验」时填入密钥，否则留空
FEISHU_WEBHOOK_SECRET=
