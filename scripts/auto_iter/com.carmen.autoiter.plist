<?xml version="1.0" encoding="UTF-8"?>
<!-- 卡门智投 自动迭代 Loop · 每晚一轮（模板：验证首跑通过后再 cp 到 ~/Library/LaunchAgents/ 并 launchctl load）
     部署前先把 __REPO__ 替换为本仓绝对路径、__HOME__ 替换为 $HOME（launchd 不展开 ~ 和变量）。
     ⚠️ 无人值守自动合并到生产仓库，启用前确保 STOP_LOOP kill 开关可用、首跑已witness。-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carmen.autoiter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/auto_iter/run_cycle.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:8118</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:8118</string>
        <key>PATH</key>
        <string>__HOME__/.npm-global/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/auto_iter/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/auto_iter/launchd.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
